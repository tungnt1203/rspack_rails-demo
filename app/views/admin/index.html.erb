<div class="screen__intro">
  <h1>A page with its own bundle</h1>
  <p>
    This layout links the <code>admin</code> entry, built from
    <code>app/javascript/entrypoints/admin.ts</code> and the
    <code>admin.css</code> next to it. None of the home page's JavaScript is downloaded here.
  </p>
</div>

<section aria-label="Bundles">
  <div class="bundles">
    <% @bundles.each do |name, files| %>
      <div class="panel <%= "panel--current" if name == "admin" %>">
        <div class="panel__head">
          <h2><%= name %> <%= "(this page)" if name == "admin" %></h2>
        </div>
        <p class="total"><%= number_to_human_size(files.sum { |_, size| size.to_i }) %><small><%= files.size %> files</small></p>
        <table class="table">
          <thead><tr><th scope="col">File</th><th scope="col" class="num">Size</th></tr></thead>
          <tbody>
            <% files.each do |file, size| %>
              <tr><td class="mono"><%= file %></td><td class="num"><%= size ? number_to_human_size(size) : "–" %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
  <p class="note-line">File sizes in app/assets/builds, before gzip. <%= Rails.env.development? ? "Development builds include source for HMR and debugging; production builds are minified." : "Minified production build." %></p>
</section>

<section class="panel" aria-labelledby="downloaded-title">
  <div class="panel__head">
    <h2 id="downloaded-title">What the browser actually downloaded</h2>
    <p>Read by admin.ts from the Resource Timing API after the page loaded.</p>
  </div>
  <table class="table">
    <thead><tr><th scope="col">File</th><th scope="col" class="num">Transferred</th><th scope="col" class="num">ms</th></tr></thead>
    <tbody data-admin-resources><tr><td class="muted" colspan="3">…</td></tr></tbody>
  </table>
</section>

<section class="panel" aria-labelledby="notes-title">
  <div class="panel__head">
    <h2 id="notes-title">Notes (<%= @notes.size %>)</h2>
  </div>
  <% if @notes.empty? %>
    <p class="empty">No notes yet. Post one on the home page.</p>
  <% else %>
    <table class="table">
      <thead><tr><th scope="col">Note</th><th scope="col">Posted</th><th scope="col" class="num"><span class="visually-hidden">Actions</span></th></tr></thead>
      <tbody>
        <% @notes.each do |note| %>
          <tr>
            <td><%= note.body %></td>
            <td class="muted"><time datetime="<%= note.created_at.iso8601 %>"><%= note.created_at.to_fs(:short) %></time></td>
            <td class="num"><%= button_to "Delete", note_path(note), method: :delete, class: "row-action" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
