<h1 class="text-3xl font-bold tracking-tight">A page with its own bundle</h1>
<p class="mt-2 max-w-2xl text-zinc-400">
  This layout links the <code class="rounded bg-zinc-800 px-1">admin</code> entry, built from
  <code class="rounded bg-zinc-800 px-1">app/javascript/entrypoints/admin.ts</code> and the
  <code class="rounded bg-zinc-800 px-1">admin.css</code> next to it. None of the home page's JavaScript is downloaded here.
</p>

<section class="mt-8 grid gap-4 sm:grid-cols-2">
  <% @bundles.each do |name, files| %>
    <div class="rounded-2xl border p-5 <%= name == "admin" ? "border-orange-500/50 bg-orange-500/5" : "border-zinc-800" %>">
      <h2 class="font-mono font-semibold"><%= name %> <%= "(this page)" if name == "admin" %></h2>
      <ul class="mt-3 space-y-1 font-mono text-sm">
        <% files.each do |file, size| %>
          <li class="flex justify-between gap-3"><span class="truncate text-zinc-400"><%= file %></span><span><%= size ? number_to_human_size(size) : "–" %></span></li>
        <% end %>
      </ul>
      <p class="mt-3 border-t border-zinc-800 pt-2 text-right font-mono text-sm font-semibold">
        <%= number_to_human_size(files.sum { |_, size| size.to_i }) %>
      </p>
    </div>
  <% end %>
</section>
<p class="mt-2 text-xs text-zinc-500">File sizes in app/assets/builds, before gzip. <%= Rails.env.development? ? "Development builds include source for HMR and debugging; production builds are minified." : "Minified production build." %></p>

<section class="mt-8 rounded-2xl border border-zinc-800 p-5">
  <h2 class="font-semibold">What the browser actually downloaded</h2>
  <p class="mt-1 text-sm text-zinc-400">Read by admin.ts from the Resource Timing API after the page loaded.</p>
  <table class="mt-3 w-full font-mono text-sm">
    <thead class="text-left text-zinc-500"><tr><th class="font-normal">file</th><th class="text-right font-normal">transferred</th><th class="text-right font-normal">ms</th></tr></thead>
    <tbody data-admin-resources><tr><td class="text-zinc-500" colspan="3">…</td></tr></tbody>
  </table>
</section>

<section class="mt-8 rounded-2xl border border-zinc-800 p-5">
  <h2 class="font-semibold">Notes <span class="text-zinc-500">(<%= @notes.size %>)</span></h2>
  <ul class="mt-3 divide-y divide-zinc-800 text-sm">
    <% @notes.each do |note| %>
      <li class="flex items-center justify-between gap-3 py-2">
        <span class="truncate"><%= note.body %> <span class="ml-2 text-xs text-zinc-500"><%= note.created_at.to_fs(:short) %></span></span>
        <%= button_to "Delete", note_path(note), method: :delete, class: "text-xs text-zinc-500 hover:text-red-400" %>
      </li>
    <% end %>
    <% if @notes.empty? %><li class="py-2 text-zinc-500">No notes yet. Post one on the home page.</li><% end %>
  </ul>
</section>
