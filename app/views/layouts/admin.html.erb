<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin · rspack_rails demo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="The demo's admin page, which loads its own small bundle instead of the home page's.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# A second entry: app/javascript/entrypoints/admin.ts and admin.css. No React, Stimulus, Turbo or Leaflet here. %>
    <%= rspack_stylesheet_tag "admin", "data-turbo-track": "reload" %>
    <%= rspack_javascript_tag "admin", "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="bar">
      <div class="container bar__inner">
        <span class="bar__name">rspack_rails demo <span class="tag">admin</span></span>
        <%= link_to "Back to the demo", root_path, class: "link" %>
      </div>
    </header>
    <main class="container screen">
      <%= yield %>
    </main>
  </body>
</html>
