<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Rspack Demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="A Rails 8.1 app bundled by rspack_rails: React, Stimulus, lazy chunks, a Web Worker and Turbo Streams, each running live.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rspack Demo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= rspack_javascript_tag "application", "data-turbo-track": "reload" %>
    <%= rspack_stylesheet_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <a class="skip visually-hidden" href="#main">Skip to the page</a>
    <header class="site-nav">
      <div class="container site-nav__bar">
        <%= link_to "rspack_rails demo", root_path, class: "wordmark", "aria-label": "rspack_rails demo, home" %>
        <nav aria-label="Site" class="nav-links">
          <%= link_to "Demo", root_path, class: "hide-narrow", "aria-current": (current_page?(root_path) ? "page" : nil) %>
          <%= link_to "How it works", how_path, "aria-current": (current_page?(how_path) ? "page" : nil) %>
          <%= link_to "Admin", admin_path %>
        </nav>
      </div>
    </header>
    <main id="main">
      <%= yield %>
    </main>
    <footer class="site-footer">
      <div class="container site-footer__grid">
        <p><strong>rspack_rails demo.</strong> Rails <%= Rails.version %> with rspack_rails <%= RspackRails::VERSION %>, deployed with Kamal. Every widget on these pages runs from the bundles Rspack built.</p>
        <nav aria-label="Footer" class="nav-links">
          <%= link_to "Demo", root_path %>
          <%= link_to "How it works", how_path %>
          <%= link_to "Admin", admin_path %>
        </nav>
      </div>
    </footer>
  </body>
</html>
