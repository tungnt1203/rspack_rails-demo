<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rspack Rails Demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rspack Rails Demo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Not `stylesheet_link_tag :app`: that links every CSS file under app/assets,
        including rspack's app/assets/builds/*.bundle.css (print.bundle.css without media="print"). %>
    <%= stylesheet_link_tag "application" %>
    <%= rspack_javascript_tag "application", "data-turbo-track": "reload" %>
    <%= rspack_stylesheet_tag "application", "data-turbo-track": "reload" %>
    <%= rspack_stylesheet_tag "print", media: "print" %>
  </head>

  <body class="bg-dots min-h-screen bg-slate-50 text-slate-800 antialiased">
    <%= render "shared/nav" %>
    <main class="mx-auto max-w-3xl px-4 py-10"><%= yield %></main>
  </body>
</html>
