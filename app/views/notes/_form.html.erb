<%= form_with model: note, id: "note_form", class: "note-form" do |form| %>
  <%= form.label :body, "Note", class: "visually-hidden" %>
  <%= form.text_field :body, placeholder: "Write a note, then open this page in a second tab",
        maxlength: 80, autocomplete: "off", required: true,
        "aria-invalid": (note.errors.any? ? "true" : nil),
        "aria-describedby": (note.errors.any? ? "note_help" : nil),
        class: "input" %>
  <%= form.submit "Post", class: "key key--primary" %>
<% end %>
<% if note.errors.any? %>
  <p class="help" id="note_help"><%= note.errors.full_messages.to_sentence %></p>
<% end %>
