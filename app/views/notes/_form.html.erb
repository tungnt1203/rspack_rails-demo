<%= form_with model: note, id: "note_form", class: "flex gap-2" do |form| %>
  <%= form.text_field :body, placeholder: "Write a note, then open this page in a second tab",
        maxlength: 80, autocomplete: "off", required: true,
        class: "flex-1 rounded-lg border px-3 py-2 text-sm focus:border-orange-500 focus:outline-none #{note.errors.any? ? "border-red-400" : "border-slate-300"}" %>
  <%= form.submit "Post", class: "rounded-lg bg-orange-500 px-4 py-2 text-sm font-medium text-white hover:bg-orange-600" %>
<% end %>
<% if note.errors.any? %>
  <p class="mt-1 text-xs text-red-500"><%= note.errors.full_messages.to_sentence %></p>
<% end %>
