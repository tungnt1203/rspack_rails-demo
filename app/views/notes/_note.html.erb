<li id="<%= dom_id(note) %>" class="note">
  <span class="note__body">
    <%= note.body %>
    <time datetime="<%= note.created_at.iso8601 %>"><%= note.created_at.strftime("%H:%M:%S") %></time>
  </span>
  <%= button_to "Delete", note_path(note), method: :delete,
        class: "key--quiet", form: { class: "shrink-0" } %>
</li>
