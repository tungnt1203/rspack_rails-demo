<%= turbo_frame_tag "server_stats" do %>
  <dl class="grid grid-cols-2 gap-x-4 gap-y-1 font-mono text-sm">
    <dt class="text-slate-500">rendered at</dt><dd><%= Time.current.strftime("%H:%M:%S.%L") %></dd>
    <dt class="text-slate-500">ruby</dt><dd><%= RUBY_VERSION %> <%= "+YJIT" if defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled? %></dd>
    <dt class="text-slate-500">environment</dt><dd><%= Rails.env %></dd>
    <dt class="text-slate-500">process up</dt><dd><%= distance_of_time_in_words(@booted_at, Time.current, include_seconds: true) %></dd>
    <dt class="text-slate-500">notes in db</dt><dd><%= Note.count %></dd>
  </dl>
  <%= link_to "Reload this frame", stats_path, class: "mt-3 inline-block text-sm font-medium text-orange-600 hover:underline" %>
<% end %>
