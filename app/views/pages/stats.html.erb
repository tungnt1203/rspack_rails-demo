<%= turbo_frame_tag "server_stats" do %>
  <dl class="facts">
    <dt>rendered at</dt><dd><%= Time.current.strftime("%H:%M:%S.%L") %></dd>
    <dt>ruby</dt><dd><%= RUBY_VERSION %> <%= "+YJIT" if defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled? %></dd>
    <dt>environment</dt><dd><%= Rails.env %></dd>
    <dt>process up</dt><dd><%= distance_of_time_in_words(@booted_at, Time.current, include_seconds: true) %></dd>
    <dt>notes in db</dt><dd><%= Note.count %></dd>
  </dl>
  <p class="mt-4"><%= link_to "Reload this frame", stats_path, class: "link" %></p>
<% end %>
