<% content_for :title, "rspack_rails demo" %>

<section class="mb-10">
  <p class="text-sm font-medium text-orange-600">Rails <%= Rails.version %> · rspack_rails <%= RspackRails::VERSION %></p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight">Bundled by Rspack, served by Rails</h1>
  <p class="mt-3 max-w-2xl text-slate-600">
    Everything interactive on this page comes from one entry, <code class="rounded bg-slate-100 px-1">app/javascript/application.js</code>,
    built by Rspack into <code class="rounded bg-slate-100 px-1">app/assets/builds</code> and served through the asset pipeline.
  </p>
</section>

<div class="grid gap-6 md:grid-cols-2">
  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-semibold">React component</h2>
    <%= react_component "Playground", owner: "Your" %>
  </section>

  <div class="space-y-6">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold">Stimulus controller</h2>
      <p class="mt-1 text-sm text-slate-600">A TypeScript controller, registered automatically. Server time was <%= Time.current.strftime("%H:%M:%S") %>; the browser says:</p>
      <p data-controller="clock" class="mt-3 font-mono text-3xl text-orange-600">--:--:--</p>
    </section>

    <section data-controller="lazy" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold">Lazy chunk</h2>
      <p class="mt-1 text-sm text-slate-600">Not part of the first download. Pressing the button fetches it.</p>
      <button data-action="lazy#load" class="mt-3 rounded-lg border border-orange-500 px-4 py-2 text-sm font-medium text-orange-600 hover:bg-orange-50">
        Load sparkline
      </button>
      <div data-lazy-target="output" class="mt-3"></div>
      <p data-lazy-target="status" class="mt-1 font-mono text-xs text-slate-500"></p>
    </section>
  </div>
</div>

<div class="mt-6 grid gap-6 md:grid-cols-2">
  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Leaflet map</h2>
    <p class="mt-1 text-sm text-slate-600">Leaflet's JS and CSS (with its marker images) load in their own lazy chunks.</p>
    <div data-controller="map"
         data-map-places-value="<%= [["Hồ Gươm, Hà Nội", 21.0287, 105.8524], ["Chợ Bến Thành, TP.HCM", 10.7725, 106.698], ["Cầu Rồng, Đà Nẵng", 16.0612, 108.2272]].to_json %>"
         class="mt-4 h-64 rounded-lg bg-slate-100"></div>
  </section>

  <section data-controller="chart" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Chart.js, on demand</h2>
    <p class="mt-1 text-sm text-slate-600">About 200 KB that the page does not download until you ask.</p>
    <button data-chart-target="button" data-action="chart#show"
            class="mt-3 rounded-lg border border-orange-500 px-4 py-2 text-sm font-medium text-orange-600 hover:bg-orange-50 disabled:opacity-60">
      Show chart
    </button>
    <canvas data-chart-target="canvas" class="mt-3"></canvas>
  </section>
</div>

<section data-controller="sortable" class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold">SortableJS</h2>
  <p class="mt-1 text-sm text-slate-600">Drag to rank. Order: <span data-sortable-target="output" class="font-medium text-orange-600"></span></p>
  <ul data-sortable-target="list" class="mt-4 grid gap-2 sm:grid-cols-4">
    <% %w[Rspack esbuild Vite webpack].each do |name| %>
      <li data-name="<%= name %>" class="cursor-grab rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium active:cursor-grabbing"><%= name %></li>
    <% end %>
  </ul>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold">What the helpers linked</h2>
  <p class="mt-1 text-sm text-slate-600">
    <code class="rounded bg-slate-100 px-1">rspack_javascript_tag "application"</code> and
    <code class="rounded bg-slate-100 px-1">rspack_stylesheet_tag "application"</code> read Rspack's manifest
    <%= @dev_server ? "(from the dev server, which is running)" : "(from the last build)" %>:
  </p>
  <dl class="mt-4 grid gap-2 font-mono text-sm sm:grid-cols-[8rem_1fr]">
    <dt class="text-slate-500">scripts</dt>
    <dd><%= @entry.scripts.map { |file| @dev_server ? "/rspack/#{file}" : asset_path(file) }.join(", ") %></dd>
    <dt class="text-slate-500">stylesheets</dt>
    <dd><%= @entry.stylesheets.map { |file| @dev_server ? "/rspack/#{file}" : asset_path(file) }.join(", ") %></dd>
  </dl>
</section>
