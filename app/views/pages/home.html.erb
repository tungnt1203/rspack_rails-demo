<% content_for :title, "Rspack Rails Demo" %>

<header class="mb-10">
  <h1 class="text-3xl font-bold tracking-tight">Rails + Rspack, with hot reloading</h1>
  <p class="mt-2 text-slate-600">
    Run <code class="rounded bg-slate-200 px-1.5 py-0.5 text-sm">bin/dev</code>, then edit the files named on each
    card. Changes show up in this page without a reload.
  </p>
</header>

<div class="grid gap-6">
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
           data-controller="counter" data-counter-count-value="0">
    <h2 class="text-lg font-semibold">Stimulus controller in TypeScript</h2>
    <p class="mt-1 text-sm text-slate-500">
      <code>app/javascript/controllers/counter_controller.ts</code>, registered automatically. Click a few times,
      then edit the controller: it is swapped in place and the count stays.
    </p>
    <div class="mt-4 flex items-center gap-3">
      <button data-action="counter#increment"
              class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
        Click me
      </button>
      <button data-action="counter#reset" class="text-sm text-slate-500 hover:text-slate-900">Reset</button>
      <span data-counter-target="output" class="ml-auto font-mono text-slate-700">0 clicks</span>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Tailwind CSS v4</h2>
    <p class="mt-1 text-sm text-slate-500">
      Add a class in <code>app/views/pages/home.html.erb</code> (try <code>bg-amber-100</code> on this card) or edit
      <code>app/javascript/application.css</code>. The new CSS is applied without a reload.
    </p>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" data-controller="lazy">
    <h2 class="text-lg font-semibold">Code splitting</h2>
    <p class="mt-1 text-sm text-slate-500">
      <code>import("../lib/primes")</code> builds a separate chunk that is only downloaded when you click.
      Watch the network tab.
    </p>
    <div class="mt-4 flex items-center gap-3">
      <button data-action="lazy#load"
              class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold hover:bg-slate-50">
        Load primes.ts
      </button>
      <span data-lazy-target="output" class="text-sm text-slate-700"></span>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" data-controller="clipboard">
    <h2 class="text-lg font-semibold">Start your own app</h2>
    <div class="mt-3 flex items-start gap-3">
      <pre data-clipboard-target="source"
           class="flex-1 overflow-x-auto rounded-lg bg-slate-900 p-4 text-sm text-slate-100">bundle add rspack_rails
bin/rails rspack:install
bin/rails rspack:install:stimulus
bin/rails rspack:install:typescript
bin/rails rspack:install:tailwind
bin/dev</pre>
      <button data-action="clipboard#copy" data-clipboard-target="button"
              class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50">Copy</button>
    </div>
  </section>
</div>
