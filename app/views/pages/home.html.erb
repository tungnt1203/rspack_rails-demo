<% content_for :title, "rspack_rails demo" %>

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="hero-title">Bundled by Rspack, served by Rails</h1>
      <p class="lead">Every widget below comes from one entry, built by Rspack and served by the asset pipeline.</p>
    </div>

    <div class="hero__panel">
      <section class="manifest" aria-labelledby="helpers-title">
        <div class="manifest__head">
          <h2 id="helpers-title">What the helpers linked</h2>
          <p><code>rspack_javascript_tag "application"</code> and <code>rspack_stylesheet_tag "application"</code> read Rspack's manifest <%= @dev_server ? "(from the dev server, which is running)" : "(from the last build)" %>:</p>
        </div>
        <dl>
          <dt>entry</dt><dd>app/javascript/application.js</dd>
          <dt>scripts</dt><dd class="is-live"><%= @entry.scripts.map { |file| @dev_server ? "/rspack/#{file}" : asset_path(file) }.join(", ") %></dd>
          <dt>stylesheets</dt><dd class="is-live"><%= @entry.stylesheets.map { |file| @dev_server ? "/rspack/#{file}" : asset_path(file) }.join(", ") %></dd>
          <dt>built into</dt><dd>app/assets/builds</dd>
          <dt>Rails</dt><dd><%= Rails.version %></dd>
          <dt>rspack_rails</dt><dd><%= RspackRails::VERSION %></dd>
        </dl>
      </section>
    </div>
  </div>
</section>

<section class="group" aria-labelledby="g-components">
  <div class="container">
    <div class="group__head">
      <h2 id="g-components">React and Stimulus</h2>
    </div>
    <div class="blocks">
      <section class="block cut col-span-7">
        <h3>React component</h3>
        <div class="well grow"><%= react_component "Playground", owner: "Your" %></div>
        <p class="block__file"><code>app/javascript/components/Playground.tsx</code></p>
      </section>

      <div class="stack col-span-5">
        <section class="block cut">
          <h3>Stimulus controller</h3>
          <p class="block__line">A TypeScript controller, registered automatically. Server time was <%= Time.current.strftime("%H:%M:%S") %>; the browser says:</p>
          <p data-controller="clock" class="clock">--:--:--</p>
          <p class="block__file"><code>controllers/clock_controller.ts</code></p>
        </section>

        <section data-controller="sortable" class="block cut">
          <h3>SortableJS</h3>
          <p class="block__line">Drag to rank. Order: <span data-sortable-target="output" class="font-medium text-accent-deep"></span></p>
          <ul data-sortable-target="list" class="rank">
            <% %w[Rspack esbuild Vite webpack].each do |name| %>
              <li data-name="<%= name %>"><%= name %></li>
            <% end %>
          </ul>
          <p class="block__file"><code>controllers/sortable_controller.ts</code></p>
        </section>
      </div>
    </div>
  </div>
</section>

<section class="group group--alt" aria-labelledby="g-chunks">
  <div class="container">
    <div class="group__head">
      <h2 id="g-chunks">Lazy chunks</h2>
      <p>None of these are in the first download.</p>
    </div>
    <div class="blocks">
      <section class="block cut col-span-8">
        <h3>Leaflet map</h3>
        <p class="block__line">Leaflet's JS and CSS (with its marker images) load in their own lazy chunks.</p>
        <div data-controller="map"
             data-map-places-value="<%= [["Hồ Gươm, Hà Nội", 21.0287, 105.8524], ["Chợ Bến Thành, TP.HCM", 10.7725, 106.698], ["Cầu Rồng, Đà Nẵng", 16.0612, 108.2272]].to_json %>"
             class="map-frame grow"></div>
        <p class="block__file"><code>controllers/map_controller.ts</code></p>
      </section>

      <div class="stack col-span-4">
        <section data-controller="lazy" class="block cut">
          <h3>Lazy chunk</h3>
          <p class="block__line">Not part of the first download. Pressing the button fetches it.</p>
          <div><button type="button" data-action="lazy#load" class="key">Load sparkline</button></div>
          <div data-lazy-target="output"></div>
          <p data-lazy-target="status" class="status"></p>
          <p class="block__file"><code>controllers/lazy_controller.ts</code></p>
        </section>

        <section data-controller="chart" class="block cut">
          <h3>Chart.js, on demand</h3>
          <p class="block__line">About 200 KB that the page does not download until you ask.</p>
          <div><button type="button" data-chart-target="button" data-action="chart#show" class="key">Show chart</button></div>
          <canvas data-chart-target="canvas"></canvas>
          <p class="block__file"><code>controllers/chart_controller.ts</code></p>
        </section>
      </div>
    </div>
  </div>
</section>

<section class="group" aria-labelledby="g-styles">
  <div class="container">
    <div class="group__head">
      <h2 id="g-styles">Styles and assets</h2>
    </div>
    <div class="blocks">
      <section class="block cut col-span-6">
        <h3>CSS Modules and Sass</h3>
        <p class="block__line">A React component styled by <code>ThemeSwatches.module.scss</code> (Sass loops and math) and <code>Badge.module.css</code>. Class names are scoped per file.</p>
        <div class="well"><%= react_component "ThemeSwatches" %></div>
        <p class="block__file"><code>components/ThemeSwatches.tsx</code></p>
      </section>

      <section data-controller="assets" class="block cut col-span-6">
        <h3>Images and fonts</h3>
        <p class="block__line">Imported from TypeScript and CSS. Above 8 KB a file is emitted with a hash; below, it is inlined.</p>
        <img data-assets-target="hero" alt="" class="shot">
        <dl class="facts">
          <dt>hero.jpg</dt><dd data-assets-target="heroUrl" class="truncate"></dd>
          <dt class="flex items-center gap-2"><img data-assets-target="bolt" alt="" class="size-4"> bolt.svg</dt><dd data-assets-target="boltUrl" class="truncate"></dd>
        </dl>
        <div class="bg-grid font-sample">
          <p class="f-display">Familjen Grotesk for heads</p>
          <p>IBM Plex Sans for reading</p>
          <p class="f-mono">JetBrains Mono for code, all three from Fontsource, on a grid.svg background set in CSS</p>
        </div>
        <p class="block__file"><code>controllers/assets_controller.ts</code></p>
      </section>
    </div>
  </div>
</section>

<section class="group group--alt" aria-labelledby="g-turbo">
  <div class="container">
    <div class="group__head">
      <h2 id="g-turbo">Turbo and Action Cable</h2>
      <p>Open this page in a second tab to watch the notes arrive.</p>
    </div>
    <div class="blocks">
      <section id="live-notes" class="block cut col-span-7">
        <h3>Turbo Streams over Action Cable</h3>
        <p class="block__line">
          Posting answers with a Turbo Stream, and every other tab on this page gets the same note through
          <code>turbo_stream_from "notes"</code>.
        </p>
        <%= turbo_stream_from "notes" %>
        <%= render "notes/form", note: Note.new %>
        <ul id="notes" class="notes-list">
          <%= render @notes %>
        </ul>
        <p class="block__file"><code>notes_controller.rb</code> and <code>models/note.rb</code></p>
      </section>

      <div class="stack col-span-5">
        <section data-controller="live" class="block cut">
          <div class="block__top">
            <h3>Live from the server</h3>
            <span data-live-target="status" class="live-state"><span class="dot is-wait"></span> connecting</span>
          </div>
          <p class="block__line">A custom Action Cable channel pushes these numbers every second.</p>
          <svg viewBox="0 0 100 30" preserveAspectRatio="none" class="meter" aria-hidden="true">
            <polyline data-live-target="line" stroke-width="0.8" vector-effect="non-scaling-stroke" points=""></polyline>
          </svg>
          <dl class="facts">
            <dt>server time</dt><dd data-live-target="at">–</dd>
            <dt>memory (RSS)</dt><dd data-live-target="rss">–</dd>
            <dt>threads</dt><dd data-live-target="threads">–</dd>
            <dt>cable clients</dt><dd data-live-target="connections">–</dd>
            <dt>notes</dt><dd data-live-target="notes">–</dd>
          </dl>
          <p class="block__file"><code>channels/metrics_channel.rb</code></p>
        </section>

        <section class="block cut">
          <h3>Turbo Frame, loaded lazily</h3>
          <p class="block__line">Fetched from <code>/stats</code> when it scrolls into view. The link inside reloads only the frame.</p>
          <%= turbo_frame_tag "server_stats", src: stats_path, loading: :lazy do %>
            <p class="status">Loading…</p>
          <% end %>
          <p class="block__file"><code>pages/stats.html.erb</code></p>
        </section>
      </div>
    </div>
  </div>
</section>

<section class="group" aria-labelledby="g-worker">
  <div class="container">
    <div class="group__head">
      <h2 id="g-worker">Web Worker</h2>
      <p>Thirty million random samples, filtered into a histogram. The bar below moves with <code>requestAnimationFrame</code>: it keeps going while the worker runs, and freezes on the main thread.</p>
    </div>
    <section data-controller="worker" class="block cut" aria-label="Histogram">
      <div class="ticker">
        <div data-worker-target="ticker" class="ticker__dot"></div>
      </div>
      <div class="controls">
        <button type="button" data-action="worker#runInWorker" class="key key--primary">Run in a worker</button>
        <button type="button" data-action="worker#runOnMainThread" class="key">Run on the main thread</button>
        <label>
          Keep
          <input data-worker-target="limit" data-action="change->worker#limitChanged" type="range" min="0.5" max="4" step="0.5" value="3" class="range">
          <span data-worker-target="limitLabel" class="w-12 font-[family-name:var(--font-outlier)]"></span>
        </label>
      </div>
      <div data-worker-target="chart" class="histogram well">Press a button</div>
      <p data-worker-target="status" class="status"></p>
      <p class="block__file"><code>controllers/worker_controller.ts</code> and <code>workers/histogram.worker.ts</code></p>
    </section>
  </div>
</section>
